APP_NAME="XHS Agent Refactored"
APP_VERSION="0.2.0"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# LLM provider (OpenAI-compatible protocol)
# DeepSeek example:
LLM_PROVIDER="deepseek"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
LLM_VISION_MODEL=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3

# Optional provider-specific aliases
# OPENAI_API_KEY=""
# OPENAI_MODEL=""
# OPENAI_BASE_URL=""
# OPENAI_TEMPERATURE=0.7
# DASHSCOPE_API_KEY=""
# ALIYUN_MODEL="qwen-plus"
# ALIYUN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

REVIEW_THRESHOLD=80
MAX_REFLECTIONS=3
IMAGE_OUTPUT_DIR="data/output/images"
SAMPLE_NOTE_PATH="data/raw/sample_notes.json"
